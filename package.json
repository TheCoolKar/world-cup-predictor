{
  "name": "world-cup-predictor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "fetch-odds": "python3 scripts/fetch_polymarket_odds.py",
    "train-model": "python3 scripts/train_model.py",
    "scrape-ea-fc": "python3 scripts/scrape_ea_fc_ratings.py",
    "fetch-results": "node scripts/fetchResults.js",
    "live-feed": "node scripts/fetchLiveFeed.mjs --watch",
    "live-feed-once": "node scripts/fetchLiveFeed.mjs",
    "fetch-squads": "node scripts/fetchFotmobSquads.mjs",
    "fetch-squads-stats": "node scripts/fetchFotmobSquads.mjs --stats",
    "fetch-player-stats": "node scripts/fetchPlayerStats.mjs",
    "build-squad-strength": "node scripts/buildSquadStrength.mjs",
    "fetch-form": "node scripts/fetchRecentForm.mjs",
    "sim": "node scripts/generateMonteCarlo.mjs",
    "snapshot-predictions": "node scripts/snapshotPredictions.mjs",
    "refresh:daily": "npm run fetch-form && npm run sim",
    "refresh:full": "npm run fetch-form && npm run fetch-player-stats && npm run build-squad-strength && npm run sim"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "flag-icons": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "postcss": "^8.5.25",
    "supabase": "^2.111.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
